# Copy to .env (never committed). Without the three LLM settings Inventra runs in keyless mode.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=            # a Claude Sonnet model ID from OpenRouter's model list
LLM_TIMEOUT_SECONDS=15

# Single planner login (design doc section 15): every action is attributed to this user.
PLANNER_USER=planner

# Browser origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# Watcher: files dropped into INBOX_DIR are validated, loaded and re-planned automatically.
WATCHER_ENABLED=1
# INBOX_DIR=./runtime/inbox
# RUNTIME_DIR=./runtime          # DuckDB file, inbox, archive, quarantine
# ANSWER_KEY_DIR=./data/judges/answer_key   # read only by the evaluation replay

MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=50000
